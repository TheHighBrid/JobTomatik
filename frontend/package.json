{
  "name": "jobtomatik",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "test": "node --test",
    "build": "vite build",
    "preview": "vite preview",
    "cap:add:android": "cap add android",
    "cap:sync": "cap sync",
    "cap:open:android": "cap open android",
    "android:prepare": "npm run build && npx cap sync android",
    "android:open": "npm run android:prepare && npx cap open android",
    "android:lint": "npm run android:prepare && cd android && ./gradlew lintDebug",
    "build:apk": "npm run build:apk:debug",
    "build:apk:debug": "npm run android:prepare && cd android && ./gradlew assembleDebug",
    "build:apk:release": "npm run android:prepare && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@headlessui/react": "^2.0.4",
    "@tanstack/react-query": "^5.104.0",
    "axios": "^1.20.0",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.37.0",
    "react": "^19.3.0",
    "react-circular-progressbar": "^2.1.0",
    "react-dom": "^19.3.0",
    "react-dropzone": "^20.1.2",
    "react-hot-toast": "^2.6.1",
    "react-router-dom": "7.18.4",
    "recharts": "^3.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.1"
  }
}

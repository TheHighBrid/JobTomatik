{
  "name": "jobtomatik",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "test": "node --test",
    "build": "vite build",
    "preview": "vite preview",
    "cap:add:android": "cap add android",
    "cap:sync": "cap sync",
    "cap:open:android": "cap open android",
    "android:prepare": "npm run build && npx cap sync android",
    "android:open": "npm run android:prepare && npx cap open android",
    "android:lint": "npm run android:prepare && cd android && ./gradlew lintDebug",
    "build:apk": "npm run build:apk:debug",
    "build:apk:debug": "npm run android:prepare && cd android && ./gradlew assembleDebug",
    "build:apk:release": "npm run android:prepare && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@headlessui/react": "^2.0.4",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.7.2",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.27.0",
    "react": "^19.2.8",
    "react-circular-progressbar": "^2.1.0",
    "react-dom": "^19.2.8",
    "react-dropzone": "^19.1.1",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.10.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.2.13"
  }
}

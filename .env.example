# Runtime profile
# Use development for local/Termux/Docker use, test for CI, and production for a hardened deployment.
APP_ENV=development
# Disable interactive OpenAPI/Swagger pages on public deployments when they are not needed.
ENABLE_API_DOCS=true

# Exact runtime identity
# Set both values to the exact git commit that is being launched. The API, Celery worker,
# beat process, Android build metadata, and certification surfaces must agree on this SHA.
# For a repository checkout, a safe launch value is: git rev-parse HEAD
JOBTOMATIK_RUNTIME_REVISION=
JOBTOMATIK_EXPECTED_REVISION=
# Runtime role is assigned by Compose/launch tooling (api, worker, beat, cli, ci).
JOBTOMATIK_RUNTIME_ROLE=unknown

# Database
# Local default for Android + Termux + Ubuntu PRoot.
DATABASE_URL=sqlite:///./jobtomatik.db
# Docker Compose database password. Replace it outside local-only development.
POSTGRES_PASSWORD=jobtomatik_pass
# Optional PostgreSQL deployment example. Start PostgreSQL and create the database/user before enabling it.
# DATABASE_URL=postgresql://jobtomatik:replace-me@localhost:5432/jobtomatik

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Security
# Required for production, real-submission pilots, or real recruiter follow-up sending.
# Use at least 32 random UTF-8 bytes.
SECRET_KEY=replace-with-at-least-32-random-characters
# Optional separate key for encrypted applicant answer policies. Keep stable after policies are created.
# When empty, SECRET_KEY is used.
ANSWER_VAULT_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Comma-separated credentialed browser origins. Wildcards are rejected.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://localhost,http://localhost,capacitor://localhost

# AI
# Default is free local cover-letter templates. Set AI_PROVIDER=anthropic only after adding billing/credits.
AI_PROVIDER=template
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Email
# If SENDGRID_API_KEY is empty, ordinary product email is privacy-redacted mock metadata.
# Supervised recruiter follow-ups never treat mock mode as successful delivery.
SENDGRID_API_KEY=
FROM_EMAIL=noreply@jobtomatik.com

# Job search
# Keep false for real use. Set true only for local UI demos when boards block scraping.
DEV_MOCK_JOBS=false

# Persistent application browser
# Desktop/XFCE mode launches a dedicated Chromium profile. Android-only mode should
# keep Termux-native chromium-browser open with remote debugging and set
# APPLICATION_BROWSER_CDP_ENDPOINT=http://127.0.0.1:9222. When that endpoint is
# configured, JobTomatik attaches to it and never launches or closes the browser.
APPLICATION_BROWSER_PROFILE_DIR=browser_profiles/jobtomatik-operator
APPLICATION_BROWSER_HEADLESS=false
# Optional path to system Chromium/Chrome. Empty uses Playwright's installed Chromium.
APPLICATION_BROWSER_EXECUTABLE=
# Android-native browser bridge. Leave empty when JobTomatik should launch Chromium itself.
APPLICATION_BROWSER_CDP_ENDPOINT=
# Zero creates the retained-browser handoff immediately when automatic target resolution
# cannot continue. Set a positive value only for a dedicated interactive worker because
# the wait occupies the current Celery task for the configured duration.
APPLICATION_TARGET_HUMAN_WAIT_SECONDS=0

# Emergency stop
# False is the normal fail-safe default. Set true to stop scheduled execution, platform
# automation, live submission, and retained-browser resume before browser work begins.
AUTOMATION_GLOBAL_KILL_SWITCH=false

# Real-submission release controls
# The development profile starts false. Autonomous or reviewed releases may promote
# this to true when the selected adapter and operating profile meet the owner's criteria.
ALLOW_REAL_APPLICATION_SUBMIT=false
# Outbound recruiter communication is a separate permission. Application submission
# approval never enables this flag or authorizes a recruiter email.
ALLOW_REAL_FOLLOWUP_SEND=false
# Follow-up approval can bind a scheduled message only inside this future horizon.
SUPERVISED_FOLLOWUP_MAX_SCHEDULE_DAYS=30
# Intermediate platform pilot controls for collecting reviewed real-world evidence.
# These are stages on the path to autonomous certification, not the final product model.
GREENHOUSE_SUPERVISED_PILOT_ENABLED=false
LEVER_SUPERVISED_PILOT_ENABLED=false
SUPERVISED_APPROVAL_TTL_MINUTES=20
SUPERVISED_APPROVAL_MAX_TTL_MINUTES=60

# Canonical Greenhouse pilot evidence
# The Phase A baseline is read-only and artifact-backed. Runtime ingestion writes only Phase B records.
GREENHOUSE_PILOT_BASELINE_PATH=evidence/greenhouse-phase-a-baseline.csv
GREENHOUSE_PILOT_LEDGER_PATH=evidence/greenhouse-pilot-ledger.jsonl
GREENHOUSE_PILOT_READINESS_JSON_PATH=evidence/greenhouse-pilot-readiness.json
GREENHOUSE_PILOT_READINESS_MARKDOWN_PATH=evidence/greenhouse-pilot-readiness.md

# Canonical Lever pilot evidence
# The Lever files are separate from Greenhouse. A missing Phase A baseline counts as zero evidence.
LEVER_PILOT_BASELINE_PATH=evidence/lever-phase-a-baseline.csv
LEVER_PILOT_LEDGER_PATH=evidence/lever-pilot-ledger.jsonl
LEVER_PILOT_READINESS_JSON_PATH=evidence/lever-pilot-readiness.json
LEVER_PILOT_READINESS_MARKDOWN_PATH=evidence/lever-pilot-readiness.md

# Scheduled autonomous operation
# The development profile starts false. A promoted autonomous release enables this after
# adapter maturity, limits, exclusions, recovery, confirmation, and kill switches are ready.
AUTOPILOT_ENABLED=false
AUTOPILOT_DEFAULT_DAILY_CAP=5
AUTOPILOT_DEFAULT_WEEKLY_CAP=20
# UTC quiet-hours window. Equal values disable quiet hours; wraparound windows are supported.
AUTOPILOT_QUIET_HOURS_START_UTC=0
AUTOPILOT_QUIET_HOURS_END_UTC=6
# Repeated operational failures pause scheduled application creation.
AUTOPILOT_FAILURE_THRESHOLD=3
AUTOPILOT_FAILURE_WINDOW_MINUTES=60
AUTOPILOT_CIRCUIT_BREAKER_MINUTES=120
# Comma-separated: greenhouse,lever,ashby,smartrecruiters,workday,generic or all.
AUTOPILOT_DISABLED_PLATFORMS=

# Resumable human handoffs
# Dry runs retain CAPTCHA/login/MFA/navigation boundaries automatically. This flag also
# enables retained-browser handoffs for explicitly approved non-dry runs.
ENABLE_RESUMABLE_HANDOFFS=false
# Local-CDP sessions require API and application workers to reach the same browser node.
JOBTOMATIK_BROWSER_NODE_ID=local-node
HANDOFF_STORAGE_DIR=handoff_sessions
# Certified defaults: 20-minute session, 5-minute interaction lease, 60-minute maximum session.

# Job Boards / integrations, optional
RAPIDAPI_KEY=

# Frontend
VITE_API_URL=http://127.0.0.1:8010
VITE_JOBTOMATIK_RUNTIME_REVISION=

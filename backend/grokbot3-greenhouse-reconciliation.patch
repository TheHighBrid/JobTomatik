@@ -0,0 +1,541 @@
+"""Synthetic reconciliation and duplicate-defense tests (Greenhouse lane, Bot 3).
+
+All results here are SYNTHETIC: in-memory database, no browser, no employer, no real
+submission, no approval for a real action. They exercise the accounting layer only and
+do not certify physical Greenhouse behavior.
+
+Scenarios:
+  1. submit -> confirmation -> evidence -> confirmed
+  2. submit -> ambiguous result -> submission_uncertain (never confirmed without evidence)
+  3. confirmation -> process crash -> restart -> reconcile
+  4. confirmed -> retry -> blocked
+  5. same job -> new application -> blocked
+  6. stale approval -> blocked
+  7. changed payload -> approval invalid
+"""
+
+from __future__ import annotations
+
+from datetime import datetime, timedelta
+
+import pytest
+
+from app.models.application import (
+    Application,
+    ApplicationAutomationState,
+    ApplicationEvent,
+    ApplicationStatus,
+    ManualReviewReason,
+    ManualReviewStatus,
+    ManualReviewTask,
+    SubmissionEvidence,
+    SubmissionEvidenceType,
+)
+from app.models.handoff import (
+    HandoffChallengeType,
+    HandoffSessionStatus,
+    ManualHandoffSession,
+)
+from app.models.job import Job, JobSource, JobStatus
+from app.models.submission_approval import SubmissionApproval, SubmissionApprovalStatus
+from app.models.submission_integrity import (
+    SubmissionAttempt,
+    SubmissionAttemptStatus,
+    SubmissionEvidenceReceipt,
+)
+from app.models.user import User
+from app.services.application_integrity import (
+    closed_application_task_result,
+    submission_is_closed,
+)
+from app.services.application_reconciliation import (
+    RECONCILED_EVENT,
+    reconcile_application_from_evidence,
+    reconcile_interrupted_applications,
+)
+from app.services.application_recovery import recover_stale_application_attempt
+from app.services.application_state import (
+    InvalidApplicationTransition,
+    record_submission_evidence,
+    transition_application_state,
+)
+from app.services.submission_integrity import (
+    DuplicateSubmissionIdentityError,
+    approval_submission_binding_hash,
+    build_submission_identity_aliases,
+    claim_submission_attempt,
+    claim_submission_identity_aliases,
+    reserve_submission_attempt,
+    submission_attempt_replay_result,
+)
+
+GREENHOUSE_URL = "https://job-boards.greenhouse.io/synthetic/jobs/900001"
+CONFIRMATION_URL = GREENHOUSE_URL + "/confirmation"
+
+
+# ---------------------------------------------------------------- fixtures
+
+
+def _user(db, suffix="a"):
+    item = User(
+        email=f"gh-recon-{suffix}@example.test",
+        hashed_password="not-used-in-test",
+        full_name="Synthetic Candidate",
+    )
+    db.add(item)
+    db.flush()
+    return item
+
+
+def _job(db, suffix="a", url=GREENHOUSE_URL):
+    item = Job(
+        external_id=f"gh-recon-{suffix}",
+        title="Synthetic Role",
+        company="Synthetic Employer",
+        url=url,
+        source=JobSource.manual,
+        status=JobStatus.approved,
+        raw_data={},
+    )
+    db.add(item)
+    db.flush()
+    return item
+
+
+def _application(
+    db,
+    user,
+    job,
+    *,
+    state=ApplicationAutomationState.applying.value,
+    key=None,
+    started_minutes_ago=60,
+    live=True,
+):
+    started = datetime.utcnow() - timedelta(minutes=started_minutes_ago)
+    item = Application(
+        user_id=user.id,
+        job_id=job.id,
+        status=ApplicationStatus.applying,
+        automation_state=state,
+        source_listing_url=job.url,
+        submission_attempt_count=1,
+        last_submission_attempt_at=started,
+        submission_idempotency_key=key or f"gh-recon:{user.id}:{job.id}",
+        created_at=started,
+    )
+    db.add(item)
+    db.flush()
+    claim_submission_identity_aliases(
+        db,
+        item,
+        build_submission_identity_aliases(job, application=item),
+    )
+    db.add(
+        ApplicationEvent(
+            application_id=item.id,
+            event_type="application_attempt_started",
+            from_state=ApplicationAutomationState.ready_to_apply.value,
+            to_state=ApplicationAutomationState.applying.value,
+            payload={"dry_run": not live, "attempt": 1},
+            created_at=started,
+        )
+    )
+    db.flush()
+    return item
+
+
+def _approval(db, user, application, *, reference="ghsup-synthetic-1"):
+    now = datetime.utcnow()
+    item = SubmissionApproval(
+        reference=reference,
+        application_id=application.id,
+        user_id=user.id,
+        platform="greenhouse",
+        status=SubmissionApprovalStatus.active.value,
+        employer="Synthetic Employer",
+        role="Synthetic Role",
+        application_url=GREENHOUSE_URL,
+        submission_idempotency_key=application.submission_idempotency_key,
+        profile_snapshot_hash="1" * 64,
+        resume_hash="2" * 64,
+        cover_letter_hash="3" * 64,
+        answer_payload_hash="4" * 64,
+        combined_payload_hash="5" * 64,
+        approved_at=now,
+        expires_at=now + timedelta(minutes=20),
+        approval_metadata={
+            "adapter_version": "greenhouse-v1",
+            "target_identity_hash": "6" * 64,
+        },
+    )
+    db.add(item)
+    db.flush()
+    item.approval_metadata = {
+        **dict(item.approval_metadata or {}),
+        "submission_binding_hash": approval_submission_binding_hash(item),
+    }
+    db.flush()
+    return item
+
+
+def _sufficient_evidence(db, application, *, external_id="gh-application-900001"):
+    evidence = record_submission_evidence(
+        db,
+        application,
+        SubmissionEvidenceType.confirmation_page,
+        is_sufficient=True,
+        final_url=CONFIRMATION_URL,
+        confirmation_text="Thank you for applying.",
+        external_application_id=external_id,
+        metadata={"platform": "greenhouse", "synthetic": True},
+    )
+    db.flush()
+    return evidence
+
+
+def _events(db, application, event_type):
+    return (
+        db.query(ApplicationEvent)
+        .filter(
+            ApplicationEvent.application_id == application.id,
+            ApplicationEvent.event_type == event_type,
+        )
+        .order_by(ApplicationEvent.id.asc())
+        .all()
+    )
+
+
+# --------------------------------------------- 1. evidence -> confirmed
+
+
+def test_submit_confirmation_evidence_then_confirmed(db_session):
+    user = _user(db_session)
+    application = _application(db_session, user, _job(db_session))
+
+    # Evidence-before-state-promotion: no evidence, no promotion by any route.
+    for target in (
+        ApplicationAutomationState.submitted,
+        ApplicationAutomationState.confirmed,
+    ):
+        with pytest.raises(InvalidApplicationTransition, match="evidence"):
+            transition_application_state(db_session, application, target, "premature")
+
+    unchanged = reconcile_application_from_evidence(db_session, application)
+    assert unchanged["reconciled"] is False
+    assert unchanged["reason"] == "no_sufficient_evidence"
+    assert application.automation_state == ApplicationAutomationState.applying.value
+
+    _sufficient_evidence(db_session, application)
+    result = reconcile_application_from_evidence(db_session, application)
+
+    assert result["reconciled"] is True
+    assert result["reason"] == "promoted_from_evidence"
+    assert result["automatic_retry_allowed"] is False
+    assert application.automation_state == ApplicationAutomationState.confirmed.value
+    assert application.status == ApplicationStatus.applied
+    assert application.applied_at is not None
+    # Reconciliation consumes evidence; it never creates any.
+    assert db_session.query(SubmissionEvidence).count() == 1
+    hops = [
+        (event.from_state, event.to_state)
+        for event in _events(db_session, application, RECONCILED_EVENT)
+    ]
+    assert hops == [("applying", "submitted"), ("submitted", "confirmed")]
+
+
+# ----------------------------------- 2. ambiguous -> submission_uncertain
+
+
+def test_ambiguous_result_stays_uncertain_and_never_confirms(db_session):
+    user = _user(db_session)
+    application = _application(db_session, user, _job(db_session))
+
+    # An ambiguous page produced a screenshot but no confirmation signal.
+    ambiguous = record_submission_evidence(
+        db_session,
+        application,
+        SubmissionEvidenceType.screenshot,
+        is_sufficient=False,
+        final_url=GREENHOUSE_URL,
+        screenshot_path="/state/evidence/ambiguous.png",
+        metadata={"platform": "greenhouse", "synthetic": True},
+    )
+    db_session.flush()
+    assert ambiguous.is_sufficient is False
+
+    before = reconcile_application_from_evidence(db_session, application)
+    assert before["reconciled"] is False
+    assert before["reason"] == "no_sufficient_evidence"
+    assert application.automation_state == ApplicationAutomationState.applying.value
+
+    recovered = recover_stale_application_attempt(
+        db_session,
+        application,
+        timeout_minutes=30,
+    )
+    assert recovered["recovered"] is True
+    assert application.automation_state == ApplicationAutomationState.submission_uncertain.value
+
+    after = reconcile_application_from_evidence(db_session, application)
+    assert after["reconciled"] is False
+    assert after["reason"] == "no_sufficient_evidence"
+    assert application.automation_state == ApplicationAutomationState.submission_uncertain.value
+    review = (
+        db_session.query(ManualReviewTask)
+        .filter(ManualReviewTask.application_id == application.id)
+        .one()
+    )
+    assert review.status == ManualReviewStatus.open.value
+    assert review.reason_code == ManualReviewReason.submission_confirmation_uncertain.value
+    assert _events(db_session, application, RECONCILED_EVENT) == []
+
+
+# ----------------------- 3. confirmation -> crash -> restart -> reconcile
+
+
+def test_crash_after_confirmation_reconciles_after_restart(db_session):
+    user = _user(db_session)
+    application = _application(db_session, user, _job(db_session))
+    approval = _approval(db_session, user, application)
+    attempt, _ = reserve_submission_attempt(
+        db_session, application, approval, task_id="gh-crash-task"
+    )
+    claimed, owner = claim_submission_attempt(
+        db_session, application, approval, attempt_reference=attempt.reference
+    )
+    assert owner is True
+    # claim_submission_attempt updates the row without refreshing the ORM object.
+    db_session.refresh(claimed)
+    assert claimed.status == SubmissionAttemptStatus.in_progress.value
+
+    # The confirmation was recorded durably, then the worker died before promotion.
+    evidence = _sufficient_evidence(db_session, application)
+
+    # Restart: stale recovery runs first and fails closed.
+    recovered = recover_stale_application_attempt(
+        db_session, application, timeout_minutes=30
+    )
+    assert recovered["recovered"] is True
+    assert application.automation_state == ApplicationAutomationState.submission_uncertain.value
+
+    # A stale final-submit handoff is still active for the uncertain application.
+    review = (
+        db_session.query(ManualReviewTask)
+        .filter(ManualReviewTask.application_id == application.id)
+        .one()
+    )
+    handoff = ManualHandoffSession(
+        application_id=application.id,
+        manual_review_id=review.id,
+        user_id=user.id,
+        challenge_type=HandoffChallengeType.final_submit.value,
+        status=HandoffSessionStatus.awaiting_user.value,
+        idempotency_key="gh-crash-handoff",
+        resume_token_hash="a" * 64,
+        encrypted_resume_token="synthetic",
+        resume_token_prefix="synthetic",
+        expires_at=datetime.utcnow() + timedelta(minutes=10),
+    )
+    db_session.add(handoff)
+    db_session.flush()
+
+    results = reconcile_interrupted_applications(db_session)
+    db_session.flush()
+
+    assert len(results) == 1
+    assert results[0]["reconciled"] is True
+    assert results[0]["from_state"] == ApplicationAutomationState.submission_uncertain.value
+    assert results[0]["evidence_id"] == evidence.id
+    assert application.automation_state == ApplicationAutomationState.confirmed.value
+    assert application.status == ApplicationStatus.applied
+
+    db_session.refresh(claimed)
+    db_session.refresh(review)
+    db_session.refresh(handoff)
+    assert claimed.status == SubmissionAttemptStatus.succeeded.value
+    assert review.status == ManualReviewStatus.resolved.value
+    assert handoff.status == HandoffSessionStatus.cancelled.value
+
+    # Replay of the same sweep is a no-op: one promotion, no extra events.
+    event_count = db_session.query(ApplicationEvent).count()
+    again = reconcile_application_from_evidence(db_session, application)
+    assert again["reconciled"] is False
+    assert again["reason"] == "already_final"
+    assert db_session.query(ApplicationEvent).count() == event_count
+
+
+def test_reconciliation_refuses_evidence_owned_by_another_application(db_session):
+    user = _user(db_session)
+    owner = _application(db_session, user, _job(db_session, "owner"))
+    victim = _application(
+        db_session,
+        user,
+        _job(db_session, "victim", url=GREENHOUSE_URL + "-2"),
+        key="gh-recon:victim",
+    )
+    stolen = SubmissionEvidence(
+        application_id=victim.id,
+        evidence_type=SubmissionEvidenceType.confirmation_page.value,
+        is_sufficient=True,
+        final_url=CONFIRMATION_URL,
+        confirmation_text="Thank you for applying.",
+        evidence_metadata={"platform": "greenhouse", "synthetic": True},
+    )
+    db_session.add(stolen)
+    db_session.flush()
+    db_session.add(
+        SubmissionEvidenceReceipt(
+            fingerprint="f" * 64,
+            application_id=owner.id,
+            user_id=user.id,
+            evidence_id=stolen.id,
+            evidence_type=stolen.evidence_type,
+            final_url=CONFIRMATION_URL,
+        )
+    )
+    db_session.flush()
+
+    result = reconcile_application_from_evidence(db_session, victim)
+
+    assert result["reconciled"] is False
+    assert result["reason"] == "evidence_receipt_owned_by_other_application"
+    assert result["existing_application_id"] == owner.id
+    assert victim.automation_state == ApplicationAutomationState.applying.value
+
+
+# ------------------------------------------- 4. confirmed -> retry -> blocked
+
+
+def test_confirmed_application_blocks_every_retry_path(db_session):
+    user = _user(db_session)
+    application = _application(db_session, user, _job(db_session))
+    approval = _approval(db_session, user, application)
+    attempt, _ = reserve_submission_attempt(
+        db_session, application, approval, task_id="gh-retry-task"
+    )
+    claim_submission_attempt(
+        db_session, application, approval, attempt_reference=attempt.reference
+    )
+    _sufficient_evidence(db_session, application)
+    assert reconcile_application_from_evidence(db_session, application)["reconciled"]
+
+    # Terminal state: no outgoing transition of any kind.
+    for target in (
+        ApplicationAutomationState.ready_to_apply,
+        ApplicationAutomationState.applying,
+        ApplicationAutomationState.failed,
+        ApplicationAutomationState.needs_review,
+    ):
+        with pytest.raises(InvalidApplicationTransition):
+            transition_application_state(
+                db_session, application, target, "retry", allow_same=False
+            )
+
+    # Queued stale work is turned into an idempotent no-op before any approval use.
+    assert submission_is_closed(application) is True
+    replay_task = closed_application_task_result(application, dry_run=False)
+    assert replay_task["idempotent"] is True
+    assert replay_task["already_submitted"] is True
+
+    # The finished attempt can never be claimed again.
+    db_session.refresh(attempt)
+    replay, is_owner = claim_submission_attempt(
+        db_session, application, approval, attempt_reference=attempt.reference
+    )
+    assert is_owner is False
+    replay_result = submission_attempt_replay_result(replay)
+    assert replay_result["duplicate_final_action_prevented"] is True
+    assert replay_result["automatic_retry_allowed"] is False
+

@@ -0,0 +1,295 @@
+"""Evidence-gated forward reconciliation for interrupted submissions.
+
+Recovery (``application_recovery``) is deliberately fail-closed: an attempt that was
+abandoned in ``applying`` becomes ``submission_uncertain``. That is correct when no
+confirmation was observed. It leaves a gap when the worker died *after* sufficient
+confirmation evidence was durably recorded but *before* the lifecycle state was
+promoted: the application stays uncertain, an uncertainty review task stays open, a
+final-submit handoff may stay active, and the submission attempt stays "active".
+
+This module closes that gap without relaxing any invariant:
+
+* It never creates, edits, or infers evidence. It only consumes evidence rows that were
+  already recorded as sufficient through the normal evidence pipeline.
+* State promotion still goes through ``transition_application_state`` so the
+  evidence-before-state-promotion invariant is enforced by the canonical state machine.
+* Evidence whose replay receipt belongs to a different application is refused.
+* It never reopens retry authority. Closing the attempt and handoff only removes stale
+  "active" markers; ``submission_is_closed`` then blocks any further queued work.
+* It is idempotent: running it twice produces one promotion and one event.
+
+It is additive and intentionally not wired into Celery beat or the API here. Wiring is a
+shared-file change that must be coordinated with the integration lead.
+"""
+
+from __future__ import annotations
+
+from datetime import datetime
+from typing import Any, Dict, List, Optional
+
+from sqlalchemy.orm import Session
+
+from app.models.application import (
+    Application,
+    ApplicationAutomationState,
+    ApplicationEvent,
+    ApplicationStatus,
+    ManualReviewReason,
+    ManualReviewStatus,
+    ManualReviewTask,
+    SubmissionEvidence,
+)
+from app.models.handoff import ACTIVE_HANDOFF_STATUSES, ManualHandoffSession
+from app.models.submission_integrity import (
+    ACTIVE_SUBMISSION_ATTEMPT_STATUSES,
+    SubmissionAttempt,
+    SubmissionAttemptStatus,
+    SubmissionEvidenceReceipt,
+)
+from app.services.application_state import (
+    InvalidApplicationTransition,
+    normalize_state,
+    transition_application_state,
+)
+from app.services.handoff_session import cancel_handoff_session
+from app.services.submission_integrity import finalize_submission_attempt
+
+RECONCILED_EVENT = "application_reconciled_from_evidence"
+
+# States that can legitimately be left behind by a crash between evidence persistence
+# and state promotion. Anything else (preparing, ready_to_apply, needs_review, failed)
+# is not an in-flight submission and is never promoted from evidence alone.
+RECONCILABLE_STATES = frozenset(
+    {
+        ApplicationAutomationState.applying.value,
+        ApplicationAutomationState.submission_uncertain.value,
+        ApplicationAutomationState.submitted.value,
+    }
+)
+ALREADY_FINAL_STATES = frozenset(
+    {
+        ApplicationAutomationState.confirmed.value,
+        ApplicationAutomationState.withdrawn.value,
+    }
+)
+
+
+def _result(application: Application, reconciled: bool, reason: str, **extra: Any) -> Dict[str, Any]:
+    return {
+        "application_id": application.id,
+        "reconciled": reconciled,
+        "reason": reason,
+        "state": normalize_state(application.automation_state),
+        "automatic_retry_allowed": False,
+        **extra,
+    }
+
+
+def _sufficient_evidence(db: Session, application_id: int) -> List[SubmissionEvidence]:
+    return (
+        db.query(SubmissionEvidence)
+        .filter(
+            SubmissionEvidence.application_id == application_id,
+            SubmissionEvidence.is_sufficient.is_(True),
+        )
+        .order_by(SubmissionEvidence.id.asc())
+        .all()
+    )
+
+
+def _foreign_receipt(
+    db: Session,
+    application: Application,
+    evidence: List[SubmissionEvidence],
+) -> Optional[SubmissionEvidenceReceipt]:
+    ids = [item.id for item in evidence if item.id is not None]
+    if not ids:
+        return None
+    return (
+        db.query(SubmissionEvidenceReceipt)
+        .filter(
+            SubmissionEvidenceReceipt.evidence_id.in_(ids),
+            SubmissionEvidenceReceipt.application_id != application.id,
+        )
+        .first()
+    )
+
+
+def reconcile_application_from_evidence(
+    db: Session,
+    application: Application,
+    *,
+    source: str = "reconciliation",
+) -> Dict[str, Any]:
+    """Promote one interrupted application to ``confirmed`` only on recorded evidence."""
+
+    state = normalize_state(application.automation_state)
+    if state in ALREADY_FINAL_STATES:
+        return _result(application, False, "already_final")
+    if state not in RECONCILABLE_STATES:
+        return _result(application, False, "state_not_reconcilable")
+
+    evidence = _sufficient_evidence(db, application.id)
+    if not evidence:
+        # No evidence: stay exactly where we are. Uncertain stays uncertain.
+        return _result(application, False, "no_sufficient_evidence")
+
+    foreign = _foreign_receipt(db, application, evidence)
+    if foreign is not None:
+        return _result(
+            application,
+            False,
+            "evidence_receipt_owned_by_other_application",
+            existing_application_id=foreign.application_id,
+        )
+
+    evidence_id = evidence[-1].id
+    try:
+        if state == ApplicationAutomationState.applying.value:
+            # The canonical graph has no applying -> confirmed edge. Step through
+            # submitted; both hops are individually evidence-gated.
+            transition_application_state(
+                db,
+                application,
+                ApplicationAutomationState.submitted,
+                RECONCILED_EVENT,
+                {
+                    "source": source,
+                    "from_state": state,
+                    "evidence_id": evidence_id,
+                    "evidence_created_by_reconciliation": False,
+                    "automatic_retry_allowed": False,
+                },
+                allow_same=False,
+            )
+        transition_application_state(
+            db,
+            application,
+            ApplicationAutomationState.confirmed,
+            RECONCILED_EVENT,
+            {
+                "source": source,
+                "from_state": state,
+                "evidence_id": evidence_id,
+                "evidence_created_by_reconciliation": False,
+                "automatic_retry_allowed": False,
+            },
+            allow_same=False,
+        )
+    except InvalidApplicationTransition as exc:
+        return _result(application, False, "transition_refused", error=str(exc)[:300])
+
+    now = datetime.utcnow()
+    application.status = ApplicationStatus.applied
+    application.applied_at = application.applied_at or now
+
+    closed_attempts: List[str] = []
+    attempts = (
+        db.query(SubmissionAttempt)
+        .filter(
+            SubmissionAttempt.application_id == application.id,
+            SubmissionAttempt.status.in_(ACTIVE_SUBMISSION_ATTEMPT_STATUSES),
+        )
+        .all()
+    )
+    for attempt in attempts:
+        finalize_submission_attempt(
+            db,
+            attempt,
+            status=SubmissionAttemptStatus.succeeded,
+            result={
+                "reconciled_from_evidence": True,
+                "evidence_id": evidence_id,
+                "source": source,
+            },
+        )
+        closed_attempts.append(attempt.reference)
+
+    resolved_reviews = 0
+    reviews = (
+        db.query(ManualReviewTask)
+        .filter(
+            ManualReviewTask.application_id == application.id,
+            ManualReviewTask.reason_code
+            == ManualReviewReason.submission_confirmation_uncertain.value,
+            ManualReviewTask.status.in_(
+                [ManualReviewStatus.open.value, ManualReviewStatus.in_progress.value]
+            ),
+        )
+        .all()
+    )
+    for review in reviews:
+        review.status = ManualReviewStatus.resolved.value
+        review.resolved_at = now
+        review.resolution_notes = (
+            "Resolved by evidence reconciliation: sufficient confirmation evidence "
+            f"{evidence_id} was already recorded."
+        )
+        resolved_reviews += 1
+
+    cancelled_handoffs = 0
+    sessions = (
+        db.query(ManualHandoffSession)
+        .filter(
+            ManualHandoffSession.application_id == application.id,
+            ManualHandoffSession.status.in_(ACTIVE_HANDOFF_STATUSES),
+        )
+        .all()
+    )
+    for session in sessions:
+        cancel_handoff_session(
+            db,
+            session,
+            user_id=application.user_id,
+            reason="Application reconciled from recorded confirmation evidence.",
+        )
+        cancelled_handoffs += 1
+
+    db.flush()
+    return _result(
+        application,
+        True,
+        "promoted_from_evidence",
+        evidence_id=evidence_id,
+        closed_attempts=closed_attempts,
+        resolved_reviews=resolved_reviews,
+        cancelled_handoffs=cancelled_handoffs,
+        from_state=state,
+    )
+
+
+def reconcile_interrupted_applications(
+    db: Session,
+    *,
+    user_id: Optional[int] = None,
+    limit: int = 200,
+    source: str = "reconciliation_sweep",
+) -> List[Dict[str, Any]]:
+    """Reconcile every interrupted application that already has sufficient evidence."""
+
+    query = (
+        db.query(Application)
+        .filter(Application.automation_state.in_(sorted(RECONCILABLE_STATES)))
+        .filter(
+            db.query(SubmissionEvidence.id)
+            .filter(
+                SubmissionEvidence.application_id == Application.id,
+                SubmissionEvidence.is_sufficient.is_(True),
+            )
+            .exists()
+        )
+        .order_by(Application.id.asc())
+    )
+    if user_id is not None:
+        query = query.filter(Application.user_id == user_id)
+    return [
+        reconcile_application_from_evidence(db, application, source=source)
+        for application in query.limit(max(1, int(limit))).all()
+    ]
+
+
+__all__ = [
+    "RECONCILED_EVENT",
+    "reconcile_application_from_evidence",
+    "reconcile_interrupted_applications",
+]

+)
+def test_changed_payload_invalidates_approval_binding(db_session, field):
+    user = _user(db_session, suffix=field)
+    application = _application(
+        db_session, user, _job(db_session, suffix=field), key=f"gh-recon:{field}"
+    )
+    approval = _approval(db_session, user, application, reference=f"ghsup-{field}")
+    attempt, _ = reserve_submission_attempt(
+        db_session, application, approval, task_id=f"task-{field}"
+    )
+    original_binding = attempt.binding_hash
+
+    setattr(approval, field, "9" * 64)
+    db_session.flush()
+    assert approval_submission_binding_hash(approval) != original_binding
+
+    blocked, is_owner = claim_submission_attempt(
+        db_session, application, approval, attempt_reference=attempt.reference
+    )
+
+    assert is_owner is False
+    assert blocked.status == SubmissionAttemptStatus.blocked.value
+    assert blocked.attempt_metadata["block_reason"] == "approval_binding_changed"
+    assert (
+        db_session.query(SubmissionAttempt)
+        .filter(SubmissionAttempt.status == SubmissionAttemptStatus.in_progress.value)
+        .count()
+        == 0

+def test_stale_approval_changes_binding_and_blocks_claim(db_session):
+    user = _user(db_session)
+    application = _application(db_session, user, _job(db_session))
+    approval = _approval(db_session, user, application)
+    attempt, created = reserve_submission_attempt(
+        db_session, application, approval, task_id="gh-stale-task"
+    )
+    assert created is True
+
+    # Re-issuing/extending the approval after reservation changes its exact binding.
+    approval.expires_at = approval.expires_at + timedelta(hours=6)
+    db_session.flush()
+
+    blocked, is_owner = claim_submission_attempt(
+        db_session, application, approval, attempt_reference=attempt.reference
+    )
+
+    assert is_owner is False
+    assert blocked.status == SubmissionAttemptStatus.blocked.value
+    assert blocked.attempt_metadata["block_reason"] == "approval_binding_changed"
+    assert blocked.started_at is None
+
